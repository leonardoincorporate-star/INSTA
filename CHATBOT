def match_keyword_reply(user_message: str) -> str:
    """Finds the best matching canned response or returns fallback."""
    msg = user_message.lower()
    for rule in KEYWORD_RULES:
        for kw in rule["keywords"]:
            if re.search(r"\b" + re.escape(kw) + r"\b", msg):
                return rule["response"]
    return DEFAULT_FALLBACK

def send_instagram_dm(recipient_id: str, message_text: str):
    """Sends a Direct Message back to the user via Meta Graph API."""
    params = {"access_token": PAGE_ACCESS_TOKEN}
    payload = {
        "recipient": {"id": recipient_id},
        "message": {"text": message_text}
    }
    try:
        res = requests.post(GRAPH_API_URL, params=params, json=payload, timeout=10)
        if res.status_code == 200:
            print(f"[SUCCESS] Reply sent to {recipient_id}")
        else:
            print(f"[API ERROR] {res.status_code}: {res.text}")
    except Exception as e:
        print(f"[NETWORK ERROR] Failed sending message: {e}")

@app.get("/webhook")
async def verify_webhook(request: Request):
    """Meta Webhook Challenge Verification."""
    mode = request.query_params.get("hub.mode")
    token = request.query_params.get("hub.verify_token")
    challenge = request.query_params.get("hub.challenge")

    if mode == "subscribe" and token == VERIFY_TOKEN:
        print("[WEBHOOK VERIFIED] Meta successfully subscribed to this server!")
        return Response(content=challenge, media_type="text/plain")
    return Response(content="Forbidden", status_code=status.HTTP_403_FORBIDDEN)

@app.post("/webhook")
async def handle_incoming_dm(request: Request):
    """Receives real-time customer Direct Messages from Instagram."""
    data = await request.json()

    if data.get("object") == "instagram" or data.get("object") == "page":
        for entry in data.get("entry", []):
            for messaging_event in entry.get("messaging", []):
                sender_id = messaging_event.get("sender", {}).get("id")
                message_obj = messaging_event.get("message", {})

                # Ignore echo messages sent by the bot itself
                if message_obj.get("is_echo"):
                    continue

                customer_text = message_obj.get("text", "")
                if sender_id and customer_text:
                    print(f"\n[NEW DM] From: {sender_id} | Text: {customer_text}")
                    reply = match_keyword_reply(customer_text)
                    send_instagram_dm(sender_id, reply)

        return {"status": "EVENT_RECEIVED"}

    return {"status": "IGNORED"}
